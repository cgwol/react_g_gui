{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "g_gui",
  "version": "0.1.0",
  "identifier": "com.christian.g-gui",
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "g_gui",
        "width": 1280,
        "height": 720,
        "fullscreen": false,
        "decorations": false,
        "maximized": false,
        "alwaysOnTop": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
